{
 "title": "ChuvaRota: 4 sinais de ouro",
 "uid": "chuvarota",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Lat\u00eancia p95 (s)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Tr\u00e1fego (pedidos por segundo)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (path) (rate(http_requests_total[1m]))",
     "legendFormat": "{{path}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Taxa de erros (4xx e 5xx)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(http_requests_total{status=~\"4..|5..\"}[1m])) / sum(rate(http_requests_total[1m]))",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Satura\u00e7\u00e3o (mem\u00f3ria do processo e pedidos em andamento)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "process_resident_memory_bytes",
     "legendFormat": "mem\u00f3ria",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "http_requests_in_flight",
     "legendFormat": "em andamento",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  }
 ]
}